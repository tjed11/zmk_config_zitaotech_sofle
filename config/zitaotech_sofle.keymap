#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define FUNC 1
#define RES 2
#define BOT bootloader

/ {
    input_processors {
        zip_temp_layer: zip_temp_layer {
            compatible = "zmk,input-processor-temp-layer";
            #input-processor-cells = <2>;
        };

        ip_behaviors0: ip_behaviors0 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_0>;
            bindings = <&kp RIGHT>;
        };

        ip_behaviors1: ip_behaviors1 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_1>;
            bindings = <&kp LEFT>;
        };

        ip_behaviors2: ip_behaviors2 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_2>;
            bindings = <&kp DOWN>;
        };

        ip_behaviors3: ip_behaviors3 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_3>;
            bindings = <&kp UP>;
        };
    };
};

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp LCLK>, <&bt BT_CLR>;
        };
    };

    behaviors {
        tdRMCLK: tap_dance_R_LMouse {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp RCLK>, <&mkp MCLK>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            bindings = <&kp &kp>;
        };
    };

    behaviors {
        sp_sc: behavior_spacescroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";     /* 单击优先 */
            tapping-term-ms = <200>;       /* 长按阈值 */
            bindings = <&none &kp>;        /* hold=none, tap=space */
        };
    };

    behaviors {
        LMouse_sc: behavior_LMouse_Scroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";     /* 单击优先 */
            tapping-term-ms = <200>;       /* 长按阈值 */
            bindings = <&none &mkp>;        /* hold=none, tap=Lmouse */
        };
    };

    behaviors {
        M_kp: behavior_mouse_keypress {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";     /* 单击优先 */
            tapping-term-ms = <200>;       /* 长按阈值 */
            bindings = <&mkp &kp>;        /* hold=mou key press, tap=key*/
        };
    };

    behaviors {
        BLE_encoder: BLE_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bt BT_NXT>, <&bt BT_PRV>;
        };
    };

    combos {
        compatible = "zmk,combos";

        semicolon {
            bindings = <&kp SEMI>;
            key-positions = <52 53>;
            timeout-ms = <80>;
            layers = <0>;
        };

        leftShift {
            bindings = <&kp LSHIFT>;
            key-positions = <30 59>;
            timeout-ms = <250>;
            layers = <0>;
            slow-release;
        };

        bkspRight {
            bindings = <&kp BACKSPACE>;
            key-positions = <36 35>;
            timeout-ms = <80>;
            slow-release;
            layers = <0>;
        };

        deleteRight {
            bindings = <&kp DEL>;
            key-positions = <36 37>;
            timeout-ms = <80>;
            slow-release;
            layers = <0>;
        };

        rightShift {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <62 35>;
            timeout-ms = <80>;
            slow-release;
            layers = <0>;
        };

        doubleQuote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <37 38>;
            timeout-ms = <50>;
            layers = <0>;
        };

        LCS {
            bindings = <&sk LC(LEFT_SHIFT)>;
            key-positions = <59 41 28>;
            layers = <0>;
            timeout-ms = <50>;
        };

        LGS {
            bindings = <&sk LG(LEFT_SHIFT)>;
            key-positions = <59 43 28>;
            layers = <0>;
            timeout-ms = <50>;
        };

        enterRight {
            bindings = <&kp ENTER>;
            key-positions = <62 50 51>;
            timeout-ms = <50>;
            layers = <0>;
        };

        enterLeft {
            bindings = <&kp ENTER>;
            key-positions = <44 45 59>;
            timeout-ms = <50>;
            layers = <0>;
        };

        bkspLeft {
            bindings = <&kp BACKSPACE>;
            key-positions = <28 29>;
            timeout-ms = <50>;
            layers = <0>;
        };

        deleteLeft {
            bindings = <&kp DEL>;
            key-positions = <30 29>;
            timeout-ms = <50>;
            layers = <0>;
        };

        oLeft {
            bindings = <&kp O>;
            key-positions = <28 30>;
            timeout-ms = <50>;
            layers = <0>;
        };

        qTab {
            bindings = <&kp TAB>;
            key-positions = <15 16>;
            timeout-ms = <50>;
            layers = <0>;
        };

        fTab {
            bindings = <&kp TAB>;
            key-positions = <30 31>;
            timeout-ms = <50>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&gresc              &kp N1    &kp N2              &kp N3       &kp N4                  &kp N5            &kp C_MUTE   &kp C_MUTE               &kp N6          &kp N7        &kp N8  &kp N9    &kp N0     &kp BSPC
&kp TAB             &kp Q     &kp W               &kp E        &kp R                   &kp T             &kp Y        &kp U                    &kp I           &kp O         &kp P   &kp BSLH
&kp CAPS            &kp A     &kp S               &kp D        &kp F                   &mt LEFT_SHIFT G  &mkp LCLK    &mkp LCLK                &kp H           &kp J         &kp K   &kp L     &kp APOS   &kp ENTER
&kp LSHFT           &kp Z     &kp X               &kp C        &kp V                   &mt LEFT_ALT B    &kp PG_DN    &kp PG_UP                &msc SCRL_DOWN  &msc SCRL_UP  &kp N   &kp M     &kp COMMA  &kp DOT    &kp FSLH  &kp RSHIFT
&mt LCTRL LC(LEFT)  &kp LGUI  &mt LALT LC(RIGHT)  &lt 1 SPACE  &mt LEFT_CONTROL MINUS  &kp RIGHT_SHIFT   &lt 1 SPACE  &mt RIGHT_CONTROL MINUS  &kp EQUAL       &kp GRAVE
            >;

            sensor-bindings =
                <&inc_dec_kp RIGHT LEFT>,
                <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        lower_layer {
            display-name = "LOWER";
            bindings = <
&kp ESC       &kp F1      &kp F2    &kp F3       &kp F4          &kp F5     &bt BT_CLR   &kp C_MUTE            &kp F6        &kp F7                 &kp F8    &kp F9     &kp F10   &kp F11
&trans        &kp MINUS   &kp N7    &kp N8       &kp N9          &kp PLUS   &kp GRAVE    &kp LEFT_PARENTHESIS  &kp UP_ARROW  &kp RIGHT_PARENTHESIS  &kp HOME  &kp F12
&trans        &kp PERIOD  &kp N4    &kp N5       &kp N6          &kp N0     &mkp RCLK    &mkp RCLK             &kp PIPE      &kp LEFT               &kp DOWN  &kp RIGHT  &kp SQT   &trans
&out OUT_TOG  &kp SLASH   &kp N1    &kp N2       &kp N3          &kp EQUAL  &trans       &trans                &bl BL_DEC    &bl BL_INC             &trans    &trans     &kp LBKT  &kp RBKT  &kp UNDER  &kp PLUS
&BOT          &kp LGUI    &kp LALT  &lt 2 SPACE  &kp LC(LS(F1))  &mo 1      &lt 2 SPACE  &trans                &kp DOT       &BOT
            >;

            sensor-bindings = <&BLE_encoder &inc_dec_kp UP DOWN>;
        };

        raise_layer {
            display-name = "RAISE";
            bindings = <
&kp ESC    &kp F1    &kp F2    &kp F3     &kp F4  &kp F5           &bt BT_CLR  &kp C_MUTE  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp BSPC
&kp TAB    &kp F12   &kp F7    &kp F8     &kp F9  &out OUT_TOG     &trans      &trans      &trans  &trans  &trans  &trans
&kp CAPS   &kp F11   &kp F4    &kp F5     &kp F6  &trans           &mkp RCLK   &none       &trans  &trans  &trans  &trans  &trans   &trans
&kp LSHFT  &kp F10   &kp F1    &kp F2     &kp F3  &rgb_ug RGB_TOG  &trans      &trans      &none   &none   &trans  &trans  &trans   &trans    &trans  &trans
&none      &kp LGUI  &kp LALT  &kp SPACE  &mo 1   &mo 1            &trans      &trans      &trans  &trans
            >;
        };

        MOUSE_layer {
            display-name = "MOUSE";
            bindings = <
&kp ESC    &kp N1    &kp N2    &kp N3     &kp N4    &kp N5            &bt BT_CLR      &kp C_MUTE    &kp N6     &kp N7       &kp N8  &kp N9       &kp N0     &kp BSPC
&kp TAB    &kp Q     &kp W     &kp E      &kp R     &kp T             &kp Y           &M_kp MB3 U   &kp I      &kp O        &kp P   &kp BSLH
&kp CAPS   &kp A     &kp S     &kp D      &kp F     &kp G             &mkp LCLK       &mkp LCLK     &kp H      &M_kp MB1 J  &kp K   &kp L        &kp SEMI   &kp ENTER
&kp LSHFT  &kp Z     &kp X     &kp C      &kp V     &kp B             &msc SCRL_DOWN  &msc SCRL_UP  &none      &none        &kp N   &M_kp MB2 M  &kp COMMA  &kp DOT    &kp FSLH  &kp RSHIFT
&kp LCTRL  &kp LGUI  &kp LALT  &kp SPACE  &mkp MB1  &LMouse_sc 0 MB1  &tdRMCLK        &kp MINUS     &kp EQUAL  &kp GRAVE
            >;
        };

        RES_layer {
            display-name = "RESERVE";
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };
    };
};
